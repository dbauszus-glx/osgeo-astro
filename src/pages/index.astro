---
import DateBadge from '../components/DateBadge.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL, SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';
import { newsletterIssues } from '../newsletter';
import { withBase } from '../url';

// The three most recent issues from /newsletter.
const newsletter = newsletterIssues.slice(0, 3);

const events = [
	{
		title: 'Monthly Meetup',
		description: 'Join us for our monthly community meetup in the UK.',
		date: new Date('2026-09-15'),
	},
	{
		title: 'QGIS Workshop',
		description: 'Introduction to QGIS for beginners. No experience required.',
		date: new Date('2026-10-05'),
	},
	{
		title: 'FOSS4G:UK',
		description: 'Our annual UK conference on open source geospatial.',
		date: new Date('2026-11-20'),
	},
];

const projects = [
	{ name: 'QGIS', description: 'Desktop GIS used across UK government, academia and industry.', href: 'https://qgis.org/' },
	{ name: 'PostGIS', description: 'Spatial database extender for PostgreSQL.', href: 'https://postgis.net/' },
	{ name: 'GDAL', description: 'The translator library behind almost every geospatial toolchain.', href: 'https://gdal.org/' },
	{ name: 'GeoServer', description: 'Open source server for sharing geospatial data.', href: 'https://geoserver.org/' },
];
---

<BaseLayout title={`${SITE_TITLE} — ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} landing>
	<!-- ═══════════════════════════════════════════════════════════════════════
	     HERO
	     Drop a landscape photo at public/hero.jpg and set
	     style="--hero-image: url('/hero.jpg')" on this section.
	     ═══════════════════════════════════════════════════════════════════════ -->
	<section class="hero">
		<div class="osgeo-container">
			<div class="hero-content">
				<h1>OSGeo:UK</h1>
				<p>
					Supporting open source geospatial software and community across the United Kingdom. Join
					our local chapter of the Open Source Geospatial Foundation.
				</p>
				<div class="hero-buttons">
					<a href="#events" class="osgeo-btn osgeo-btn-outline-light">Upcoming Events</a>
					<a href={`mailto:${CONTACT_EMAIL}`} class="osgeo-btn osgeo-btn-outline-light">Join Us</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════════════════════════════════════════════════
	     ABOUT
	     ═══════════════════════════════════════════════════════════════════════ -->
	<section class="osgeo-section" id="about">
		<div class="osgeo-container">
			<div class="two-col">
				<div>
					<h2 class="section-title">About OSGeo:UK</h2>
					<p class="lead">
						OSGeo:UK is a focal point for users, service providers and developers of open source
						geospatial software within the UK, for networking and advice.
					</p>
					<p>
						We promote open source geospatial tools across diverse user groups, including those with
						limited software access. Our community supports newcomers entering the geospatial field
						while fostering collaboration among developers and users.
					</p>
					<p>
						<strong>Membership is free</strong> and open to anyone interested in open source geospatial
						software. Join through our mailing list to connect with 45+ active members across the UK.
					</p>
					<p class="about-cta">
						<a href={`mailto:${CONTACT_EMAIL}`} class="osgeo-btn osgeo-btn-primary">Contact Us</a>
					</p>
				</div>
				<div>
					<h3>What We Do</h3>
					<ul class="about-list">
						<li>Networking and collaboration among developers and users</li>
						<li>Hosting FOSS4G:UK events approximately every two years</li>
						<li>Organising smaller single-day topical events</li>
						<li>Promoting initiatives like the UK QGIS User Group</li>
						<li>Offering limited funding to support open source projects</li>
						<li>Supporting newcomers to the geospatial field</li>
					</ul>
				</div>
			</div>
		</div>
	</section>	

	<!-- ═══════════════════════════════════════════════════════════════════════
	     INTRO COLUMNS (3-column feature strip)
	     ═══════════════════════════════════════════════════════════════════════ -->
	<section class="osgeo-section osgeo-bg-elevated">
		<div class="osgeo-container">
			<div class="card-grid">
				<div class="osgeo-card">
					<h2>Local Projects</h2>
					<p>Discover open source geospatial projects being used and developed in the UK.</p>
					<a href="#projects" class="osgeo-btn osgeo-btn-outline">View Projects</a>
				</div>
				<div class="osgeo-card">
					<h2>Community</h2>
					<p>Connect with local GIS professionals, developers, and enthusiasts.</p>
					<a href="#about" class="osgeo-btn osgeo-btn-outline">Join Community</a>
				</div>
				<div class="osgeo-card">
					<h2>Education</h2>
					<p>Workshops, tutorials, and resources for learning open source GIS.</p>
					<a href="#events" class="osgeo-btn osgeo-btn-outline">Learn More</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════════════════════════════════════════════════
	     NEWSLETTER (three most recent issues from /newsletter)
	     ═══════════════════════════════════════════════════════════════════════ -->
	<section class="osgeo-section" id="newsletter">
		<div class="osgeo-container">
			<h2 class="section-title">Newsletter</h2>

			{
				newsletter.map((issue) => (
					<article class="news-item">
						<DateBadge date={issue.date} />
						<div class="news-item-content">
							<h3><a href={issue.href}>{issue.title}</a></h3>
							<p class="news-item-date">
								<FormattedDate date={issue.date} /> &middot; {issue.format}
							</p>
						</div>
					</article>
				))
			}

			<p class="newsletter-more">
				<a href={withBase('/newsletter')} class="link-more">View all issues &rarr;</a>
			</p>
		</div>
	</section>

	<!-- ═══════════════════════════════════════════════════════════════════════
	     EVENT HIGHLIGHT (full-width hero style)
	     Set style="--event-image: url('/event.jpg')" to use a photo.
	     ═══════════════════════════════════════════════════════════════════════ -->
	<section class="event-highlight">
		<div class="event-highlight-content">
			<h2>FOSS4G:UK 2026</h2>
			<p>Join us for the UK's Free and Open Source Software for Geospatial conference.</p>
			<a href="#events" class="osgeo-btn osgeo-btn-primary">Learn More</a>
		</div>
	</section>

	<!-- ═══════════════════════════════════════════════════════════════════════
	     PROJECTS
	     ═══════════════════════════════════════════════════════════════════════ -->
	<section class="osgeo-section osgeo-bg-elevated" id="projects">
		<div class="osgeo-container">
			<h2 class="section-title">Projects We Support</h2>
			<div class="card-grid">
				{
					projects.map((project) => (
						<div class="osgeo-card project-card">
							<h3>{project.name}</h3>
							<p>{project.description}</p>
							<a href={project.href} class="link-more">
								{project.name}.org &rarr;
							</a>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════════════════════════════════════════════════
	     EVENTS LIST
	     ═══════════════════════════════════════════════════════════════════════ -->
	<section class="osgeo-section" id="events">
		<div class="osgeo-container">
			<h2 class="section-title">Upcoming Events</h2>
			<div class="card-grid">
				{
					events.map((event) => (
						<div class="osgeo-card">
							<DateBadge date={event.date} class="event-badge" />
							<h3>{event.title}</h3>
							<p>{event.description}</p>
						</div>
					))
				}
			</div>
			<p class="events-more">
				<a href={withBase('/blog')} class="link-more">View all events &rarr;</a>
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.lead {
		font-size: var(--osgeo-text-body-lg);
		margin-bottom: var(--osgeo-space-4);
	}

	.about-cta {
		margin-top: var(--osgeo-space-5);
	}

	.about-list {
		margin: var(--osgeo-space-3) 0;
		padding-left: var(--osgeo-space-4);
	}

	.about-list li {
		margin-bottom: var(--osgeo-space-2);
	}

	.event-badge {
		margin-bottom: var(--osgeo-space-3);
	}

	.events-more {
		margin-top: var(--osgeo-space-4);
	}

	.newsletter-more {
		display: flex;
		flex-wrap: wrap;
		gap: var(--osgeo-space-4);
		margin-top: var(--osgeo-space-4);
	}
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL, SITE_TITLE } from '../consts';

const officers = [
	{ role: 'Chair', name: 'Nick Bearman' },
	{ role: 'Secretary', name: 'Ant Scott' },
	{ role: 'Treasurer', name: 'Json Singh' },
];

const committee = [
	'Dave Barter',
	'Alastair Graham',
	'Tom Armitage',
	'Jonny Huck',
	'Dennis Bauszus',
	'James Milner',
];

// The constitutions are PDFs hosted on the current uk.osgeo.org site.
const constitutions = [
	{
		label: 'Current constitution, adopted October 2025',
		href: 'https://uk.osgeo.org/files/OSGeoUKConstitution-2025_signed_NB_AS_JS.pdf',
	},
	{
		label: 'Previous constitution, adopted March 2016 and altered by SGM in December 2018',
		href: 'https://uk.osgeo.org/files/OSGeoUKFinalConstitution_2018_amendments-signed.pdf',
	},
	{
		label: 'Earlier constitution',
		href: 'https://uk.osgeo.org/files/OSGeo%20UK%20Final%20Constitution%20-%20Signed.pdf',
	},
];
---

<BaseLayout
	title={`About — ${SITE_TITLE}`}
	description="OSGeo:UK is a focal point for users, service providers and developers of open source geospatial software within the UK, for networking and advice."
>
	<h1 class="section-title">About OSGeo:UK</h1>

	<div class="two-col">
		<div>
			<p class="lead">
				OSGeo:UK is a focal point for users, service providers and developers of open source
				geospatial software within the UK, for networking and advice.
			</p>
			<p>
				We promote open source geospatial tools across diverse user groups, including those with
				limited software access. Our community supports newcomers entering the geospatial field
				while fostering collaboration among developers and users.
			</p>
			<p>
				<strong>Membership is free</strong> and open to anyone interested in open source geospatial
				software. Join through our mailing list to connect with 45+ active members across the UK.
			</p>
			<p class="about-cta">
				<a href={`mailto:${CONTACT_EMAIL}`} class="osgeo-btn osgeo-btn-primary">Contact Us</a>
			</p>
		</div>
		<div>
			<h2>What We Do</h2>
			<ul class="about-list">
				<li>Networking and collaboration among developers and users</li>
				<li>Hosting FOSS4G:UK events approximately every two years</li>
				<li>Organising smaller single-day topical events</li>
				<li>Promoting initiatives like the UK QGIS User Group</li>
				<li>Offering limited funding to support open source projects</li>
				<li>Supporting newcomers to the geospatial field</li>
			</ul>
		</div>
	</div>

	<h2 id="legal" class="section-title legal-title">Legal</h2>

	<div class="two-col">
		<div>
			<p>OSGeo:UK is an unincorporated organisation.</p>
			<ul class="about-list">
				{
					constitutions.map((constitution) => (
						<li>
							<a href={constitution.href}>{constitution.label}</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<h3>Officers</h3>
			<ul class="about-list">
				{
					officers.map((officer) => (
						<li>
							<strong>{officer.role}:</strong> {officer.name}
						</li>
					))
				}
			</ul>

			<h3>Committee Members</h3>
			<ul class="about-list">
				{committee.map((member) => <li>{member}</li>)}
			</ul>
		</div>
	</div>
</BaseLayout>

<style>
	.lead {
		font-size: var(--osgeo-text-body-lg);
		margin-bottom: var(--osgeo-space-4);
	}

	.about-cta {
		margin-top: var(--osgeo-space-5);
	}

	.legal-title {
		margin-top: var(--osgeo-space-7);
	}

	.about-list {
		margin: var(--osgeo-space-3) 0;
		padding-left: var(--osgeo-space-4);
	}

	.about-list li {
		margin-bottom: var(--osgeo-space-2);
	}
</style>

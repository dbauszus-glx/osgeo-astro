---
import { CONTACT_EMAIL, MAILING_LIST_URL, SOCIAL_LINKS } from '../consts';

const today = new Date();
---

<footer class="site-footer">
	<div class="osgeo-container">
		<h3>Let's Connect</h3>
		<div class="footer-connect">
			<p>
				We would love to hear from you in regards to anything Open Source Geo, whether you are based in the UK or abroad. Please join our mailing list for up to date information. We do have a Twitter account but are no longer using this platform. Our Matrix room through the Element app is probably the best way to join the conversation. We would also appreciate if you could follow us on Linkedin and Bluesky. If you have any questions, please email us at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
			</p>
			<a href={MAILING_LIST_URL} class="osgeo-btn osgeo-btn-outline-light">Join Mailing List</a>
		</div>

		<div class="footer-bottom">
			<div>
				&copy; {today.getFullYear()} OSGeo:UK. Part of the <a href="https://www.osgeo.org/">Open Source Geospatial Foundation</a>.
			</div>
			<div class="social-links">
				<a href={`mailto:${CONTACT_EMAIL}`} aria-label="Email">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
						></path>
					</svg>
				</a>
				<a href={SOCIAL_LINKS.github} aria-label="GitHub">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
						></path>
					</svg>
				</a>
				<a href={SOCIAL_LINKS.bluesky} aria-label="Bluesky">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"
						></path>
